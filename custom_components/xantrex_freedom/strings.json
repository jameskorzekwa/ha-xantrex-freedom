{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Select the Freedom X remote panel",
        "description": "Choose the Bluetooth remote panel to add. Panels advertise as \"ID\" followed by the inverter serial number.",
        "data": {
          "address": "Device"
        }
      },
      "confirm": {
        "title": "Add {name}?",
        "description": "Home Assistant will connect to {name} once to read the model and serial number. Make sure the Xantrex phone app is not connected to the panel."
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the panel. Move the Bluetooth adapter closer or close the Xantrex app and try again.",
      "not_in_range": "The panel is no longer advertising. Check it is powered and in range.",
      "not_supported": "The device did not answer like a Freedom X/XC remote panel.",
      "unknown": "Unexpected error; check the Home Assistant log."
    },
    "abort": {
      "already_configured": "This remote panel is already configured.",
      "already_in_progress": "A setup for this panel is already in progress.",
      "no_devices_found": "No Freedom X remote panel is advertising within Bluetooth range.",
      "not_supported": "This device is not a Freedom X/XC remote panel."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "data": {
          "scan_interval": "Poll interval (seconds)"
        },
        "data_description": {
          "scan_interval": "How often Home Assistant connects to the panel to read values. Each poll holds the Bluetooth connection for about a second, during which the Xantrex app cannot connect."
        }
      }
    }
  },
